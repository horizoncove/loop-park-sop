# LOOP 事件看板 — zhidaoflow.cn
# Place BEFORE any SPA try_files fallback. Do not touch /app.

# API (Node container on 127.0.0.1:3010)
location ^~ /loop-kanban/api/ {
    proxy_pass http://127.0.0.1:3010/api/;
    proxy_http_version 1.1;
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_set_header Authorization $http_authorization;
    proxy_set_header X-API-Key $http_x_api_key;
    proxy_read_timeout 60s;
}

# Static export of the board
location ^~ /loop-kanban/ {
    alias /www/wwwroot/zhidaoflow.cn/loop-kanban/;
    index index.html;
}
