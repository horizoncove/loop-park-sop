POSTGRES_PASSWORD=change-me
DATABASE_URL=postgres://loop_kanban:change-me@host.docker.internal:5433/loop_kanban

# 生产请改掉 API_KEY / SESSION_SECRET。八将进入看板不需要口令。
API_KEY=change-me-machine-key
SESSION_SECRET=change-me-session-hmac
REQUIRE_AUTH=1
CORS_ORIGINS=https://zhidaoflow.cn

# When this folder is copied to /opt/loop-kanban and API source is in ./api:
# LOOP_KANBAN_API_CONTEXT=./api
